{
  "name": "schema-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "start": "node apps/server/src/main.ts",
    "cli": "node apps/server/src/cli.ts",
    "typecheck": "tsc -p . && tsc -p apps/web",
    "test": "node --test --test-concurrency=1 \"skills/**/*.test.mjs\" \"tools/**/*.test.ts\" \"packages/**/*.test.ts\" \"apps/server/**/*.test.ts\" \"apps/web/test/*.test.ts\"",
    "skill:pack": "node skills/vyvody/pack.mjs",
    "skill:check": "node skills/vyvody/check.mjs",
    "registry:scan": "node tools/registry-scan/src/cli.ts",
    "privacy": "bash scripts/check-private-data.sh",
    "check": "npm run db:generate && npm run typecheck && npm run test && npm run privacy",
    "mcp:pack": "node tools/brain-mcp/pack.mjs",
    "web:build": "vite build apps/web",
    "dev:web": "vite apps/web",
    "dev:local": "node scripts/dev-local.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^8.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cytoscape": "^3.33.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "^16.14.0-beta.17",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true
  }
}
