{
  "name": "schema-brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"skills/**/*.test.mjs\" \"tools/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "skill:pack": "node skills/vyvody/pack.mjs",
    "skill:check": "node skills/vyvody/check.mjs",
