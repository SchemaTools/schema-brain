# Образец настроек. Скопируйте в deploy/.env и заполните; deploy/.env в репозиторий не попадает.

# пароль базы — длинный случайный, например: openssl rand -base64 32
POSTGRES_PASSWORD=

# порт сервиса на сервере (свободный, внутри локальной сети)
APP_PORT=

# часовой пояс, например Europe/Moscow
TIMEZONE=

# true — только если сервис открыт по https
COOKIE_SECURE=false

LOG_LEVEL=info

# Schema Teams — список проектов (объектов) раз в час. Токен руководителя с правом видеть все объекты
# (stt_…), выпускает администратор Schema Teams. Пусто — проекты добавляются командой project add.
SCHEMA_TEAMS_URL=
SCHEMA_TEAMS_TOKEN=
